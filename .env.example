# Copie este arquivo para ".env" e preencha para o deploy na Sepolia.
# NUNCA suba o .env com a chave real para o GitHub/Sigaa.

# URL do provedor RPC (crie uma conta gratuita na Alchemy ou Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/SUA_CHAVE

# Chave privada da SUA carteira de teste (use uma carteira criada so para isto).
# Pegue Sepolia ETH gratis em um faucet (ex.: sepoliafaucet.com).
PRIVATE_KEY=coloque_sua_chave_privada_de_teste_aqui

# Opcional: relatorio de gas nos testes
REPORT_GAS=false
